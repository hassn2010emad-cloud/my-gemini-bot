def gemini_generate(user_id: int, user_text: str, inline_data: Optional[dict] = None):
    if not GEMINI_API_KEY or GEMINI_API_KEY.startswith("PUT_"):
        return "⚠️ أضف مفتاح Gemini الجديد في إعدادات الملف أولاً."

    contents = get_history(user_id)
    parts = [{"text": user_text}]
    if inline_data:
        parts.append({"inline_data": inline_data})
    contents.append({"role": "user", "parts": parts})

    url = (
        "https://generativelanguage.googleapis.com/v1beta/models/"
        f"{GEMINI_MODEL}:generateContent"
    )
    payload = {
        "system_instruction": {
            "parts": [{
                "text": (
                    "أنت مساعد مفيد ضمن بوت تيليجرام اسمه "
                    "صنع أداة القائد حسن عماد. أجب بوضوح وباللغة المناسبة "
                    "للمستخدم. إذا لم تعرف شيئاً فقل ذلك بصدق."
                )
            }]
        },
        "contents": contents,
        "generationConfig": {
            "temperature": 0.7,
            "maxOutputTokens": 2048,
        },
    }

    try:
        response = requests.post(
            url,
            headers={
                "Content-Type": "application/json",
                "x-goog-api-key": GEMINI_API_KEY,
            },
            json=payload,
            timeout=GEMINI_TIMEOUT,
        )
        try:
            data = response.json()
        except ValueError:
            return "⚠️ الخادم أرسل استجابة غير مفهومة."

        if response.status_code != 200:
            err = data.get("error", {})
            msg = err.get("message", "خطأ غير معروف")
            logger.warning("Gemini HTTP %s: %s", response.status_code, msg)
            if response.status_code == 400:
                return "⚠️ الطلب غير مقبول. تحقق من صيغة الملف أو اسم النموذج."
            if response.status_code == 401 or response.status_code == 403:
                return "🔑 مفتاح Gemini غير صالح أو لا يملك صلاحية الوصول."
            if response.status_code == 404:
                return (
                    f"النموذج {GEMINI_MODEL} غير متاح. غيّر GEMINI_MODEL "
                    "إلى نموذج موجود في قائمة نماذج Google AI Studio."
                )
            if response.status_code == 429:
                return "⏳ تم بلوغ حد الطلبات أو الحصة. انتظر ثم أعد المحاولة."
            return "⚠️ تعذّر إكمال الطلب. راجع سجل التشغيل."

        candidates = data.get("candidates", [])
        if not candidates:
            feedback = data.get("promptFeedback", {})
            return "لم يُرجع النموذج إجابة. " + str(feedback)[:500]

        answer_parts = candidates[0].get("content", {}).get("parts", [])
        answer = "\n".join(
            p.get("text", "") for p in answer_parts if p.get("text")
        ).strip()
        return answer or "وصل رد فارغ من النموذج."

    except requests.Timeout:
        return "⏱️ انتهت مهلة الاتصال. حاول مرة أخرى."
    except requests.RequestException:
        logger.exception("Gemini connection error")
        return "🌐 تعذّر الاتصال بـ Gemini. افحص الإنترنت."
    except Exception:
        logger.exception("Unexpected Gemini error")
        return "حدث خطأ غير متوقع أثناء معالجة الطلب."


async def telegram_reply_long(message, text: str):
    text = text or "لا يوجد نص للعرض."
    for start in range(0, len(text), MAX_TELEGRAM_CHUNK):
        await message.reply_text(text[start:start + MAX_TELEGRAM_CHUNK])


async def ask_and_reply(update: Update, context: ContextTypes.DEFAULT_TYPE,
                        prompt: str, inline_data: Optional[dict] = None):
    user = update.effective_user
    message = update.effective_message
    if not user or not message:
        return

    touch_user(user)

    if is_blocked(user.id):
        await message.reply_text("تم إيقاف استخدامك لهذا البوت. إذا تعتقد أن هذا خطأ فتواصل مع المالك.")
        return

    if setting_get("maintenance", "0") == "1" and not owner_only(user.id):
        await message.reply_text("🛠️ البوت تحت الصيانة حالياً. حاول لاحقاً.")
        return

    allowed, reason = check_rate_limit(user.id)
    if not allowed and not owner_only(user.id):
        await message.reply_text(reason)
        return

    await context.bot.send_chat_action(
        chat_id=message.chat_id, action=ChatAction.TYPING
    )
    answer = await asyncio.to_thread(
        gemini_generate, user.id, prompt, inline_data
    )

    # احفظ النصوص العادية الناجحة فقط، ولا تحفظ رسائل أخطاء الخدمة
    if answer and not answer.startswith(("⚠️", "🔑", "⏳", "⏱️", "🌐", "حدث خطأ")):
        add_history_pair(user.id, prompt, answer)

    await telegram_reply_long(message, answer)


