async def photo_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    if not message or not user or not message.photo:
        return
    photo = message.photo[-1]
    if photo.file_size and photo.file_size > MAX_IMAGE_BYTES:
        await message.reply_text("الصورة كبيرة جداً. أرسل صورة أصغر.")
        return
    caption = message.caption or "صف هذه الصورة واشرح العناصر المهمة فيها."
    try:
        tg_file = await context.bot.get_file(photo.file_id)
        stream = io.BytesIO()
        await tg_file.download_to_memory(out=stream)
        raw = stream.getvalue()
        if len(raw) > MAX_IMAGE_BYTES:
            await message.reply_text("حجم الصورة أكبر من الحد المسموح.")
            return
        inline = {
            "mime_type": "image/jpeg",
            "data": base64.b64encode(raw).decode("ascii"),
        }
        await ask_and_reply(update, context, caption, inline)
    except Exception:
        logger.exception("Photo handling error")
        await message.reply_text("تعذّر تحليل الصورة. حاول صورة أخرى.")


async def document_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    if not message or not user or not message.document:
        return

    doc = message.document
    filename = doc.file_name or "file"
    ext = Path(filename).suffix.lower()

    if doc.file_size and doc.file_size > MAX_DOWNLOAD_BYTES:
        await message.reply_text("حجم الملف كبير. الحد الأقصى 12 ميغابايت.")
        return

    try:
        tg_file = await context.bot.get_file(doc.file_id)
        stream = io.BytesIO()
        await tg_file.download_to_memory(out=stream)
        raw = stream.getvalue()
        if len(raw) > MAX_DOWNLOAD_BYTES:
            await message.reply_text("حجم الملف أكبر من الحد المسموح.")
            return

        if ext in (".txt", ".md", ".csv", ".json", ".py", ".html", ".log"):
            text = raw.decode("utf-8", errors="replace")
        elif ext == ".pdf":
            try:
                from pypdf import PdfReader
                reader = PdfReader(io.BytesIO(raw))
                text = "\n".join((page.extract_text() or "") for page in reader.pages)
            except ImportError:
                await message.reply_text("لقراءة PDF ثبّت المكتبة: pip install pypdf")
                return
            except Exception:
                logger.exception("PDF extraction error")
                await message.reply_text("تعذّر استخراج النص من ملف PDF.")
                return
        else:
            await message.reply_text(
                "نوع الملف غير مدعوم حالياً. أرسل PDF أو TXT أو MD أو CSV أو JSON أو PY أو HTML."
            )
            return

        text = text[:MAX_DOCUMENT_TEXT].strip()
        if not text:
            await message.reply_text("لم أجد نصاً قابلاً للاستخراج من الملف.")
            return

        instruction = message.caption or "لخّص الملف واشرح أهم النقاط وأجب عن أي أسئلة مفيدة."
        prompt = (
            f"اسم الملف: {filename}\n"
            f"تعليمات المستخدم: {instruction}\n\n"
            f"محتوى الملف (قد يكون مقتطعاً إذا كان طويلاً):\n{text}"
        )
        await ask_and_reply(update, context, prompt)
    except Exception:
        logger.exception("Document handling error")
        await message.reply_text("تعذّرت معالجة الملف.")


async def audio_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    user = update.effective_user
    if not message or not user:
        return

    audio_obj = message.voice or message.audio
    if not audio_obj:
        return
    size = getattr(audio_obj, "file_size", None)
    if size and size > MAX_DOWNLOAD_BYTES:
        await message.reply_text("ملف الصوت كبير جداً. أرسل ملفاً أصغر.")
        return

    mime = getattr(audio_obj, "mime_type", None) or "audio/ogg"
    if mime not in ("audio/ogg", "audio/mpeg", "audio/mp3", "audio/wav", "audio/aac", "audio/mp4", "audio/webm"):
        # لا نفترض أن كل أنواع الصوت مدعومة
        mime = "audio/ogg" if message.voice else "audio/mpeg"

    try:
        tg_file = await context.bot.get_file(audio_obj.file_id)
        stream = io.BytesIO()
        await tg_file.download_to_memory(out=stream)
        raw = stream.getvalue()
        if len(raw) > MAX_DOWNLOAD_BYTES:
            await message.reply_text("ملف الصوت أكبر من الحد المسموح.")
            return
        inline = {
            "mime_type": mime,
            "data": base64.b64encode(raw).decode("ascii"),
        }
        prompt = (
            message.caption
            or "فرّغ الكلام الموجود في هذا التسجيل إلى نص، ثم لخّصه باختصار. "
               "إذا لم يكن فيه كلام واضح، أخبرني بذلك."
        )
        await ask_and_reply(update, context, prompt, inline)
    except Exception:
        logger.exception("Audio handling error")
        await message.reply_text("تعذّر تحليل الصوت. جرّب ملفاً أقصر أو صيغة مدعومة.")


