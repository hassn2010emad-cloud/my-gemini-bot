async def admin_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    message = update.effective_message
    if not user or not message:
        return
    if not owner_only(user.id):
        await message.reply_text("هذا الأمر مخصص لمالك البوت.")
        return

    with db_connect() as conn:
        users = conn.execute("SELECT COUNT(*) AS n FROM users").fetchone()["n"]
        requests_total = conn.execute(
            "SELECT COALESCE(SUM(requests_total), 0) AS n FROM users"
        ).fetchone()["n"]
        blocked = conn.execute(
            "SELECT COUNT(*) AS n FROM users WHERE blocked=1"
        ).fetchone()["n"]

    maintenance = setting_get("maintenance", "0")
    await message.reply_text(
        f"👑 لوحة المالك — {APP_NAME}\n\n"
        f"👥 عدد المستخدمين: {users}\n"
        f"📊 الطلبات المسجلة: {requests_total}\n"
        f"🚫 الحسابات الموقوفة: {blocked}\n"
        f"🛠️ وضع الصيانة: {'مفعّل' if maintenance == '1' else 'متوقف'}\n"
        f"🧠 النموذج: {GEMINI_MODEL}\n\n"
        "أوامر المالك:\n"
        "/maintenance_on — تشغيل الصيانة\n"
        "/maintenance_off — إيقاف الصيانة\n"
        "/block USER_ID — إيقاف مستخدم\n"
        "/unblock USER_ID — إعادة تفعيل مستخدم"
    )


async def maintenance_on_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user or not owner_only(user.id):
        await update.effective_message.reply_text("هذا الأمر مخصص للمالك.")
        return
    setting_set("maintenance", "1")
    await update.effective_message.reply_text("🛠️ تم تشغيل وضع الصيانة.")


async def maintenance_off_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user or not owner_only(user.id):
        await update.effective_message.reply_text("هذا الأمر مخصص للمالك.")
        return
    setting_set("maintenance", "0")
    await update.effective_message.reply_text("✅ تم إيقاف وضع الصيانة.")


async def block_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user or not owner_only(user.id):
        await update.effective_message.reply_text("هذا الأمر مخصص للمالك.")
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("الاستخدام: /block USER_ID")
        return
    target = int(context.args[0])
    set_blocked(target, True)
    await update.effective_message.reply_text(f"تم إيقاف المستخدم {target} إذا كان مسجلاً.")


async def unblock_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    if not user or not owner_only(user.id):
        await update.effective_message.reply_text("هذا الأمر مخصص للمالك.")
        return
    if not context.args or not context.args[0].isdigit():
        await update.effective_message.reply_text("الاستخدام: /unblock USER_ID")
        return
    target = int(context.args[0])
    set_blocked(target, False)
    await update.effective_message.reply_text(f"تمت إعادة تفعيل المستخدم {target} إذا كان مسجلاً.")


async def post_init(application: Application):
    commands = [
        BotCommand("start", "تشغيل البوت"),
        BotCommand("help", "المساعدة"),
        BotCommand("clear", "مسح ذاكرة المحادثة"),
        BotCommand("me", "معلومات الاستخدام"),
        BotCommand("weather", "الطقس حسب المدينة"),
        BotCommand("admin", "لوحة تحكم المالك"),
    ]
    await application.bot.set_my_commands(commands)
    logger.info("Bot commands registered")


async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    logger.error("Unhandled Telegram error", exc_info=context.error)


def main():
    print("=" * 58)
    print(APP_NAME)
    print("بدء فحص الإعدادات...")
    print("=" * 58)

    if not BOT_TOKEN or BOT_TOKEN.startswith("PUT_"):
        raise SystemExit(
            "خطأ: ضع توكن تيليجرام الجديد في BOT_TOKEN أعلى الملف."
        )
    if not GEMINI_API_KEY or GEMINI_API_KEY.startswith("PUT_"):
        raise SystemExit(
            "خطأ: ضع مفتاح Gemini في GEMINI_API_KEY أعلى الملف."
        )
    if OWNER_ID == 0:
        print("تنبيه: OWNER_ID غير مضبوط؛ أوامر المالك لن تعمل.")

    init_db()
    app = (
        ApplicationBuilder()
        .token(BOT_TOKEN)
        .post_init(post_init)
        .build()
    )

    app.add_handler(CommandHandler("start", start_cmd))
    app.add_handler(CommandHandler("help", help_cmd))
    app.add_handler(CommandHandler("clear", clear_cmd))
    app.add_handler(CommandHandler("me", me_cmd))
    app.add_handler(CommandHandler("weather", weather_cmd))

    app.add_handler(CommandHandler("admin", admin_cmd))
    app.add_handler(CommandHandler("maintenance_on", maintenance_on_cmd))
    app.add_handler(CommandHandler("maintenance_off", maintenance_off_cmd))
    app.add_handler(CommandHandler("block", block_cmd))
    app.add_handler(CommandHandler("unblock", unblock_cmd))

    app.add_handler(MessageHandler(filters.PHOTO, photo_handler))
    app.add_handler(MessageHandler(filters.Document.ALL, document_handler))
    app.add_handler(MessageHandler(filters.VOICE | filters.AUDIO, audio_handler))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, text_handler))
    app.add_error_handler(error_handler)

    print("تم تجهيز البوت. جاري الاتصال بتيليجرام...")
    app.run_polling(drop_pending_updates=False)


async def text_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    message = update.effective_message
    if not message or not message.text:
        return
    prompt = message.text.strip()
    if not prompt:
        return
    if len(prompt) > MAX_INPUT_CHARS:
        await message.reply_text(
            f"رسالتك طويلة جداً. الحد الأقصى {MAX_INPUT_CHARS} حرف."
        )
        return
    await ask_and_reply(update, context, prompt)


if __name__ == "__main__":
    main()
