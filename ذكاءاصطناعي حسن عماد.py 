def db_connect():
    conn = sqlite3.connect(DB_PATH, timeout=20)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with db_connect() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                first_name TEXT NOT NULL DEFAULT '',
                username TEXT NOT NULL DEFAULT '',
                first_seen REAL NOT NULL,
                last_seen REAL NOT NULL,
                requests_total INTEGER NOT NULL DEFAULT 0,
                blocked INTEGER NOT NULL DEFAULT 0
            )
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS messages (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                role TEXT NOT NULL,
                content TEXT NOT NULL,
                created_at REAL NOT NULL
            )
        """)
        conn.execute("""
            CREATE INDEX IF NOT EXISTS idx_messages_user_id
            ON messages(user_id, id)
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS settings (
                key TEXT PRIMARY KEY,
                value TEXT NOT NULL
            )
        """)
        conn.execute("""
            INSERT OR IGNORE INTO settings(key, value)
            VALUES('maintenance', '0')
        """)
        conn.commit()


def touch_user(user):
    now = time.time()
    with db_connect() as conn:
        conn.execute("""
            INSERT INTO users(user_id, first_name, username, first_seen, last_seen)
            VALUES(?, ?, ?, ?, ?)
            ON CONFLICT(user_id) DO UPDATE SET
                first_name=excluded.first_name,
                username=excluded.username,
                last_seen=excluded.last_seen
        """, (
            user.id,
            user.first_name or "",
            user.username or "",
            now,
            now,
        ))
        conn.commit()


def is_blocked(user_id: int) -> bool:
    with db_connect() as conn:
        row = conn.execute(
            "SELECT blocked FROM users WHERE user_id=?", (user_id,)
        ).fetchone()
        return bool(row["blocked"]) if row else False


def set_blocked(user_id: int, blocked: bool):
    with db_connect() as conn:
        conn.execute(
            "UPDATE users SET blocked=? WHERE user_id=?",
            (1 if blocked else 0, user_id),
        )
        conn.commit()


def get_history(user_id: int):
    with db_connect() as conn:
        rows = conn.execute("""
            SELECT role, content FROM (
                SELECT id, role, content FROM messages
                WHERE user_id=? ORDER BY id DESC LIMIT ?
            ) ORDER BY id ASC
        """, (user_id, MAX_HISTORY_MESSAGES)).fetchall()
    return [
        {"role": row["role"], "parts": [{"text": row["content"]}]}
        for row in rows
    ]


def add_history_pair(user_id: int, prompt: str, answer: str):
    now = time.time()
    with db_connect() as conn:
        conn.executemany("""
            INSERT INTO messages(user_id, role, content, created_at)
            VALUES(?, ?, ?, ?)
        """, [
            (user_id, "user", prompt, now),
            (user_id, "model", answer, now),
        ])
        # احتفظ بآخر 30 رسالة لكل مستخدم لتجنب تضخم قاعدة البيانات
        conn.execute("""
            DELETE FROM messages WHERE user_id=? AND id NOT IN (
                SELECT id FROM messages WHERE user_id=?
                ORDER BY id DESC LIMIT 30
            )
        """, (user_id, user_id))
        conn.execute("""
            UPDATE users SET requests_total=requests_total+1
            WHERE user_id=?
        """, (user_id,))
        conn.commit()


def clear_history(user_id: int):
    with db_connect() as conn:
        conn.execute("DELETE FROM messages WHERE user_id=?", (user_id,))
        conn.commit()


def setting_get(key: str, default: str = "") -> str:
    with db_connect() as conn:
        row = conn.execute(
            "SELECT value FROM settings WHERE key=?", (key,)
        ).fetchone()
    return row["value"] if row else default


def setting_set(key: str, value: str):
    with db_connect() as conn:
        conn.execute("""
            INSERT INTO settings(key, value) VALUES(?, ?)
            ON CONFLICT(key) DO UPDATE SET value=excluded.value
        """, (key, value))
        conn.commit()


def owner_only(user_id: int) -> bool:
    return OWNER_ID != 0 and user_id == OWNER_ID


