_last_request = {}
_daily_counts = {}


def check_rate_limit(user_id: int):
    now = time.time()
    last = _last_request.get(user_id, 0)
    if now - last < RATE_LIMIT_SECONDS:
        return False, "تمهّل قليلاً بين الرسائل حتى لا تتعطل الخدمة."
    day = time.strftime("%Y-%m-%d", time.localtime(now))
    key = (user_id, day)
    count = _daily_counts.get(key, 0)
    if count >= DAILY_REQUEST_LIMIT:
        return False, f"وصلت إلى حدك اليومي التجريبي ({DAILY_REQUEST_LIMIT} طلباً)."
    _last_request[user_id] = now
    _daily_counts[key] = count + 1
    # إزالة عدادات الأيام القديمة من الذاكرة
    for old_key in list(_daily_counts):
        if old_key[1] != day:
            _daily_counts.pop(old_key, None)
    return True, ""


